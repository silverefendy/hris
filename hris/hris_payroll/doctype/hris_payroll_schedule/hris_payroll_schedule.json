   "fieldname": "column_break_1",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "pay_date_offset_days",
   "fieldtype": "Int",
   "label": "Jeda ke Hari Bayar (hari)",
   "default": "0",
