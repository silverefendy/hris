  },
  {
   "fieldname": "sunday_rule",
   "fieldtype": "Select",
   "label": "Bila Hari Bayar Jatuh Hari Minggu",
   "options": "Maju ke Senin\nTetap",
   "default": "Maju ke Senin",
   "description": "Hanya menggeser hari bayar. Akhir periode tidak berubah."
  },
  {
   "fieldname": "description",
   "fieldtype": "Small Text",
   "label": "Keterangan"
  },
  {
   "fieldname": "params_section",
   "fieldtype": "Section Break",
   "label": "Parameter Periode"
  },
  {
   "fieldname": "cut_off_day",
   "fieldtype": "Int",
   "label": "Tanggal Cut-off (1-31)",
   "depends_on": "eval:doc.schedule_type=='Bulanan'",
   "description": "Hari terakhir periode. Contoh 26 = periode 27 bulan lalu sampai 26 bulan ini. Bulan yang lebih pendek memakai hari terakhir bulan."
  },
  {
   "fieldname": "week_start_day",
   "fieldtype": "Select",
   "label": "Hari Awal Minggu",
   "options": "\nSenin\nSelasa\nRabu\nKamis\nJumat\nSabtu\nMinggu",
   "depends_on": "eval:doc.schedule_type=='Mingguan'",
   "description": "Periode 7 hari mulai dari hari ini."
  },
  {
   "fieldname": "period_days",
   "fieldtype": "Int",
   "label": "Panjang Periode (hari)",
   "depends_on": "eval:doc.schedule_type=='Harian'"
  },
  {
   "fieldname": "anchor_date",
   "fieldtype": "Date",
   "label": "Tanggal Acuan",
   "depends_on": "eval:doc.schedule_type=='Harian'",
   "description": "Awal salah satu periode. Periode lain dihitung berurutan dari tanggal ini."
  },
  {
   "fieldname": "cut_off_dates",
   "fieldtype": "Table",
   "label": "Tanggal Cut-off",
   "options": "HRIS Payroll Schedule Cutoff",
   "depends_on": "eval:doc.schedule_type=='Tanggal Tetap'",
   "description": "Contoh: 14 dan 28. Setiap tanggal adalah hari terakhir sebuah periode."
  },
  {
